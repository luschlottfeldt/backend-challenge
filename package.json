{
  "name": "nest-scaffold",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "lint": "oxlint src/ test/",
    "test": "bun test test/unit",
    "test:watch": "bun test --watch test/unit",
    "test:cov": "bun test --coverage test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "mikro-orm": "bun node_modules/@mikro-orm/cli/cli.js",
    "migration:create": "bun node_modules/@mikro-orm/cli/cli.js migration:create",
    "migration:up": "bun node_modules/@mikro-orm/cli/cli.js migration:up",
    "migration:down": "bun node_modules/@mikro-orm/cli/cli.js migration:down",
    "migration:pending": "bun node_modules/@mikro-orm/cli/cli.js migration:pending"
  },
  "mikro-orm": {
    "preferTs": true,
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1123.0",
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/migrations": "^7.1.14",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.1.14",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.14",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2"
  }
}
